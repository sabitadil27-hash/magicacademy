let mana = Number(localStorage.getItem("mana")) || 0;
let energy = Number(localStorage.getItem("energy")) || 100;
let gold = Number(localStorage.getItem("gold")) || 0;
let level = Number(localStorage.getItem("level")) || 1;
let xp = Number(localStorage.getItem("xp")) || 0;
let monsterHP = Number(localStorage.getItem("monsterHP")) || 100;
let monsterHP = 100;

function update(){
    document.getElementById("mana").textContent = mana;
    document.getElementById("energy").textContent = energy;
    document.getElementById("gold").textContent = gold;
    document.getElementById("level").textContent = level;
    document.getElementById("monsterHP").textContent = monsterHP;

    document.getElementById("xpBar").style.width = xp + "%";
}

function tap(){
    if(energy <= 0){
        alert("⚡ No energy!");
        return;
    }

    mana++;
    energy--;
    xp++;

    if(xp >= 100){
        xp = 0;
        level++;
        alert("🎉 Level Up!");
    }

    update();
}

function castFireball(){
    if(energy < 20){
        alert("⚡ Need 20 energy!");
        return;
    }

    energy -= 20;
    monsterHP -= 25;

    if(monsterHP <= 0){
        monsterHP = 100;
        gold += 50;
        alert("👹 Monster defeated! +50 Gold");
    }

    update();
}

function dailyReward(){
    gold += 100;
    alert("🎁 +100 Gold!");
    update();
}

setInterval(()=>{
    if(energy < 100){
        energy++;
        update();
    }
},1000);

update();
